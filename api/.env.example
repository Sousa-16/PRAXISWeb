# --- Database ---
# Local uvicorn: relative path in api/
DATABASE_URL=sqlite:///./praxis_web.db
# OCI Docker (set automatically by docker-compose.oci.yml):
# DATABASE_URL=sqlite:////app/praxis_data/praxis_web.db

# Optional: any Postgres URL. Unused in the live deploy.
# DATABASE_URL=postgresql://user:pass@localhost:5432/praxis_web

FRONTEND_ORIGIN=http://localhost:3000

# Shared with Vercel so the Next.js proxy can forward the real visitor IP.
# Generate once: python -c "import secrets; print(secrets.token_urlsafe(32))"
PRAXIS_PROXY_SECRET=

SENTRY_DSN=
COOKIE_SECURE=0
GUEST_TTL_HOURS=24
MAX_UPLOAD_BYTES=8388608
MAX_ROWS=20000
MAX_ACTIVE_JOBS=1
MAX_GLOBAL_JOBS=2

# --- Bases cache (match counts after API restart) ---
BASES_CACHE_DIR=data/bases_cache

# --- Object storage (optional S3-compatible) ---
OBJECT_STORAGE_BACKEND=local
S3_ENDPOINT=
S3_BUCKET=
S3_ACCESS_KEY=
S3_SECRET_KEY=
S3_REGION=us-east-1
S3_PREFIX=bases_cache
