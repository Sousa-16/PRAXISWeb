# --- Database (local dev) ---
# SQLite file in the API working directory:
DATABASE_URL=sqlite:///./praxis_web.db

# --- Supabase Postgres (production) ---
# Project Settings → Database → Connection string → URI (use the pooler for the API host).
# Transaction pooler (recommended for FastAPI):
# DATABASE_URL=postgresql://postgres.[project-ref]:[password]@aws-0-[region].pooler.supabase.com:6543/postgres
# Direct connection (migrations / one-off admin only):
# DATABASE_URL=postgresql://postgres.[project-ref]:[password]@db.[project-ref].supabase.co:5432/postgres

FRONTEND_ORIGIN=http://localhost:3000

# --- Supabase Auth (optional; leave blank for guest-only mode) ---
# Dashboard → Project Settings → API → JWT Secret (not the anon key).
SUPABASE_JWT_SECRET=
SUPABASE_URL=

SENTRY_DSN=
COOKIE_SECURE=0
GUEST_TTL_HOURS=24
MAX_UPLOAD_BYTES=20971520
MAX_ROWS=5000
MAX_ACTIVE_JOBS=1

# --- Bases cache (match counts after API restart) ---
# Local directory (default). In Docker, mount a persistent volume here.
BASES_CACHE_DIR=data/bases_cache

# --- Object storage (optional; S3-compatible, incl. Supabase Storage S3) ---
# When set, NPZ bases caches are stored in the bucket instead of local disk.
# Supabase: Project Settings → Storage → S3 connection.
OBJECT_STORAGE_BACKEND=local
S3_ENDPOINT=
S3_BUCKET=
S3_ACCESS_KEY=
S3_SECRET_KEY=
S3_REGION=us-east-1
S3_PREFIX=bases_cache

# --- Job queue (optional; Redis + RQ worker) ---
# When set, PRAXIS fits run in a separate worker process instead of API threads.
REDIS_URL=
