# Next.js dev server proxies /v1/* and /health to the API (see next.config.ts).
API_PROXY_TARGET=http://127.0.0.1:8765

# --- Supabase Auth (optional; leave blank to hide sign-in UI) ---
# Dashboard → Project Settings → API
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# --- Vercel production ---
# Set API_PROXY_TARGET to your public API URL, e.g. https://praxis-api.fly.dev
# Set the Supabase NEXT_PUBLIC_* vars above in the Vercel project settings.
