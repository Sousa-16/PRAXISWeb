# Next.js proxies /v1/* and /health via app/v1 and app/health route handlers.
API_PROXY_TARGET=http://127.0.0.1:8765

# Must match api/.env PRAXIS_PROXY_SECRET when set (forwards visitor IP to the API).
PRAXIS_PROXY_SECRET=

# --- Vercel production ---
# API_PROXY_TARGET=https://praxis-web-api.duckdns.org
# PRAXIS_PROXY_SECRET=<same secret as on the OCI api/.env>
