[Unit]
Description=Cloudflare named tunnel for PRAXIS Web API
After=network-online.target docker.service
Wants=network-online.target

[Service]
Type=simple
User=ubuntu
Restart=on-failure
RestartSec=5
# Install cloudflared, run: cloudflared tunnel login && cloudflared tunnel create praxis-api
# Then write credentials to this path and set the tunnel UUID below.
ExecStart=/usr/local/bin/cloudflared tunnel --config /home/ubuntu/.cloudflared/config.yml run
LimitNOFILE=1048576

[Install]
WantedBy=multi-user.target
